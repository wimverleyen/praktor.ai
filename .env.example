# Model configuration
PRAKTOR_MODEL=qwen2.5

# Queue
RABBITMQ_URL=amqp://guest:guest@localhost/
PRAKTOR_CONCURRENCY=4

# Prompt-response cache
CACHE_DIR=/tmp/praktor_cache
CACHE_TTL=3600

# LLM API keys
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...        # optional, only needed for gpt-* models

# File paths
MD=/path/to/markdowns/
PDF=/path/to/pdfs/
VECTOR_DB=/path/to/vector_db/

# Slack integration (optional, not yet implemented)
slack_app=xapp-...
slack_bot=xoxb-...
