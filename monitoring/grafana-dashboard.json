    {
      "id": 21,
      "type": "stat",
      "title": "Action Accuracy",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
